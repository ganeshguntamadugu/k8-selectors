apiVersion: v1
kind: Pod
metadata:
  name: node-affinity
spec:
  containers:
   - name: nginx-c
     image: nginx:stable-alpine3.24-perl
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
        - matchExpressions:
          - key: environment
            operator: In
            values:
            - prod   
  tolerations:
    - key: "project"
      operator: "Equal"
      value: "expense"
      effect: "NoSchedule"